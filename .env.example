NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# Database (Prisma MongoDB requires a replica set)
# Local Replica Set: mongodb://127.0.0.1:27017/nordlink?replicaSet=rs0&directConnection=true
# MongoDB Atlas (Cloud): mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/shorturl?retryWrites=true&w=majority
DATABASE_URL=mongodb://127.0.0.1:27017/shorturl?replicaSet=rs0&directConnection=true

# Session Secret (random 32+ character string)
SESSION_SECRET=replace-with-a-long-random-secret

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/callback/google

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/callback/github

# Cookie Domain (Leave empty for localhost)
COOKIE_DOMAIN=
